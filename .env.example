# Copy to .env for local runs, or pass with `docker compose --env-file`. Never commit the real file.
# Required: HS256 signing key, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# openai (live gpt-4o-mini) | replay (recorded responses for the pinned prompt SHA, $0) | rules (keyword stub, $0)
MODEL_BACKEND=replay
# Only needed for MODEL_BACKEND=openai and for `eval_prompts.py --record`
OPENAI_API_KEY=sk-your-key
# dev | staging | prod. The candidate prompt only receives traffic in the environments config/triage.yaml allows.
DEPLOY_ENV=dev
# Rollback lever: force every request onto one pinned prompt version (same image, no rebuild).
#PROMPT_VERSION=1.2.0
# Kill switch for the canary: 0 sends no traffic to the candidate prompt.
#CANDIDATE_PERCENT=0
LOG_DIR=logs
TOOL_METRICS_DB=logs/tool_metrics.db
