# ---- secrets: never committed (security/check_gitignore.py proves each line) ----
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx
# ---- runtime data: may hold personal data or tokens; lives on the encrypted volume, not in git ----
logs/*
!logs/.gitkeep
*.enc
dpa/work/
# ---- tooling ----
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
evals/reports/*
!evals/reports/.gitkeep
